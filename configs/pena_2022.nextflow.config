// nextflow.config


/*
 * ============================================================
 * General
 * ============================================================
 */

params {

    outdir = "/share/crsp/lab/tallie/weberrl/testing/nrsf_exploration/pena_2022/pipeline_out"


    /*
     * Input
     */

    file_csv = "/share/crsp/lab/tallie/weberrl/scripts_for_keeps/bulk_RNA_seq_nextflow/sample_sheets/pena_2022_fastqs.csv"


    /*
     * QC
     */

    run_fastqc = true

    FASTQC = "/dfs9/seyedam-lab/weberrl/conda_envs/cutrun/bin/fastqc"


    /*
     * BBDuk
     */

    trimmed_fastq_dir = "/share/crsp/lab/tallie/weberrl/testing/nrsf_exploration/pena_2022/trimmed_fastqs"


    bbduk = "/data/homezvol1/weberrl/software/bbmap/bbduk.sh"

    adapter_fa_file = "/data/homezvol1/weberrl/software/bbmap/resources/adapters.fa"

    trim_q = 10


    /*
     * Reference
     */

    transcriptome_fasta = "/share/crsp/lab/tallie/share/genome_references/mm39/gencode.vM39.transcripts_clean_Headers.fa"

    gtf = "/share/crsp/lab/tallie/share/genome_references/mm39/gencode.vM39.annotation.gtf.gz"

    chromosome_lengths = "/share/crsp/lab/tallie/share/genome_references/mm39/GRCm39.primary_assembly.chrom.sizes"


    /*
     * Kallisto
     */

    kallisto_index_dir = "/share/crsp/lab/tallie/share/genome_references/mm39/kallisto"

    kallisto_index_name = "gencode.vM39.kallisto.idx"

    kallisto_genomebam = false


    /*
     * BigWig
     */

    bigwig_bin_size = 10


    /*
     * tximport
     */

    tx2gene_dir = "/share/crsp/lab/tallie/weberrl/MACS_ER/analysis/CreERT_analysis_checking/tx2gene"

    tx2gene_name = "gencode.vM39.tx2gene.tsv"

    tximport_r = "${projectDir}/scripts/tximport_counts.R"


    /*
     * STAR
     */

    run_star = false

    STAR = "/opt/apps/star/2.7.8a/bin/STAR"

    genome_fasta = "/share/crsp/lab/tallie/weberrl/MACS_ER/analysis/CreERT_analysis_checking/GRCm39_plus_CreERT.fa.gz"

    star_index_store = "/share/crsp/lab/tallie/weberrl/MACS_ER/analysis/CreERT_analysis_checking/STAR"

    star_index_name = "GRCm39_gencodeM39_CreERT_sjdb139"

    star_sjdb_overhang = 139



}


/*
 * ============================================================
 * Executor
 * ============================================================
 */

executor {

    queueSize = 84

    account = 'TALLIE_LAB'
}


/*
 * ============================================================
 * Default process resources
 * ============================================================
 */

process {

    executor = 'slurm'

    queue  = 'standard'

    time   = '24h'

    cpus   = 1

    memory = '6 GB'


    /*
     * Reference generation
     */

    withName: kallisto_index {
        cpus   = 2
        memory = '16 GB'
    }

    withName: make_tx2gene {
        cpus   = 1
        memory = '6 GB'
    }


    /*
     * Read preprocessing
     */

    withName: trim_adapters_bbuk {
        cpus   = 4
        memory = '16 GB'
    }

    withName: fastqc_2 {
        cpus   = 4
        memory = '16 GB'
    }

    withName: multiqc {
        cpus   = 1
        memory = '4 GB'
    }


    /*
     * Quantification
     */

    withName: kallisto_quant {
        cpus = 4

        memory = params.kallisto_genomebam ?
            '64 GB' :
            '16 GB'
    }


    /*
     * Genome tracks
     */

    withName: genomebam_to_bigwig {
        cpus   = 4
        memory = '16 GB'
    }


    /*
     * Gene-level count matrix
     */

    withName: tximport_counts {
        cpus   = 1
        memory = '12 GB'
    }



    withName: star_index {
        cpus   = 8
        memory = '48 GB'
        time   = '8h'
    }

    withName: star_align {
        cpus   = 8
        memory = '48 GB'
    }
}
